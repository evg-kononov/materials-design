Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rrn", "=", 
    RowBox[{"ColorNegate", "[", "rrb", "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rrnm", "=", 
    RowBox[{"RegionResize", "[", 
     RowBox[{
      RowBox[{"ImageMesh", "[", 
       RowBox[{"rrn", ",", 
        RowBox[{"Method", "->", "\"\<DualMarchingCubes\>\""}]}], "]"}], ",", 
