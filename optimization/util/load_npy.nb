Cell[CellGroupData[{

Cell["MultipleMultiple Structures", "Subsubsection",
 CellChangeTimes->{{3.875334243600994*^9, 3.8753342532185307`*^9}, {
  3.883629397782747*^9, 
  3.88362940028753*^9}},ExpressionUUID->"e3102842-cbee-46d1-a270-\
50a4cbff385d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"workdir", "=", 
   RowBox[{"SystemDialogInput", "[", 
    RowBox[{"\"\<Directory\>\"", ",", 
     RowBox[{"Directory", "[", "]"}], ",", 
     RowBox[{"WindowTitle", "->", "\"\<Choose working directory\>\""}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<MeshTools`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"m", "=", "1"}], ",", 
    RowBox[{"m", "<=", "5"}], ",", 
    RowBox[{"m", "++"}], ",", 
    RowBox[{"(*", " ", 
     RowBox[{
     "\:0417\:0434\:0435\:0441\:044c", " ", 
      "\:0443\:043a\:0430\:0437\:0430\:043d\:043e", " ", 
      "\:0441\:043a\:043e\:043b\:044c\:043a\:043e", " ", 
      "\:0441\:0442\:0440\:0443\:043a\:0442\:0443\:0440", " ", "\:0441", " ", 
      "\:0440\:0430\:0437\:043d\:044b\:043c", " ", "mgen", " ", 
      "\:043f\:043e\:0434\:0440\:044f\:0434", " ", 
      "\:0431\:0443\:0434\:0435\:0442", " ", 
      "\:0441\:0433\:0435\:043d\:0435\:0440\:0438\:0440\:043e\:0432\:0430\
\:043d\:043e"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"mgen", "=", "1"}], ",", 
       RowBox[{"mgen", "<=", "5"}], ",", 
       RowBox[{"mgen", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rrb", "=", 
         RowBox[{"Image3D", "[", 
          RowBox[{"genCuboids", "[", 
           RowBox[{"[", 
            RowBox[{"mgen", ",", "m"}], "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"uniquenumber", "=", 
         RowBox[{"\"\<m_\>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<_mgen_\>\"", "<>", 
          RowBox[{"ToString", "[", "mgen", "]"}]}]}], ";", 
        RowBox[{"directoryname", "=", 
         RowBox[{"workdir", "<>", "\"\<m_\>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<_mgen_\>\"", "<>", 
          RowBox[{"ToString", "[", "mgen", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "directoryname", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"x0", "=", 
         RowBox[{"y0", "=", 
          RowBox[{"z0", "=", "0"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xA", "=", 
         RowBox[{"yA", "=", 
          RowBox[{"zA", "=", "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rrbm", "=", 
         RowBox[{"RegionResize", "[", 
          RowBox[{
           RowBox[{"ImageMesh", "[", 
            RowBox[{"rrb", ",", 
             RowBox[{"Method", "->", "\"\<DualMarchingCubes\>\""}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x0", ",", "xA"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y0", ",", "yA"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z0", ",", "zA"}], "}"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"Volume", "[", "rrbm", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"xA", "-", "x0"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"yA", "-", "y0"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"zA", "-", "z0"}], ")"}]}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rrn", "=", 
         RowBox[{"ColorNegate", "[", "rrb", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rrnm", "=", 
         RowBox[{"RegionResize", "[", 
          RowBox[{
           RowBox[{"ImageMesh", "[", 
            RowBox[{"rrn", ",", 
             RowBox[{"Method", "->", "\"\<DualMarchingCubes\>\""}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x0", ",", "xA"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y0", ",", "yA"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z0", ",", "zA"}], "}"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"inclusionsmesh", "=", 
           RowBox[{"ToElementMesh", "[", "rrnm", "]"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"matrixmesh", "=", 
         RowBox[{"ToElementMesh", "[", 
          RowBox[{"rrbm", ",", 
           RowBox[{"\"\<RegionHoles\>\"", "->", 
            RowBox[{"RandomPoint", "[", 
             RowBox[{"rrnm", ",", "5"}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"assembly", "=", 
         RowBox[{"AddMeshMarkers", "[", 
          RowBox[{"matrixmesh", ",", 
           RowBox[{"\"\<MeshElementsMarker\>\"", "\[Rule]", "2"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"twophaseflag", "=", "False"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"assemblypic", "=", 
         RowBox[{"Rasterize", "[", 
          RowBox[{
           RowBox[{"Show", "[", 
            RowBox[{
             RowBox[{"assembly", "[", 
              RowBox[{"\"\<Wireframe\>\"", "[", 
               RowBox[{
                RowBox[{"\"\<MeshElement\>\"", "->", "\"\<MeshElements\>\""}],
                 ",", 
                RowBox[{"\"\<MeshElementStyle\>\"", "->", 
                 RowBox[{"FaceForm", "/@", 
                  RowBox[{"{", 
                   RowBox[{"Yellow", ",", "Orange"}], "}"}]}]}]}], "]"}], 
              "]"}], ",", 
             RowBox[{"Boxed", "->", "False"}], ",", 
             RowBox[{"ViewPoint", "->", 
              RowBox[{"{", 
               RowBox[{"1.25", ",", 
                RowBox[{"-", "1.5"}], ",", "1.7"}], "}"}]}], ",", 
             RowBox[{"Axes", "->", "True"}], ",", 
             RowBox[{"LabelStyle", "->", "20"}], ",", 
             RowBox[{"AxesStyle", "->", 
              RowBox[{"Directive", "[", 
               RowBox[{"Black", ",", "Thick", ",", 
                RowBox[{"FontFamily", "->", "\"\<Cambria\>\""}]}], "]"}]}], 
             ",", 
             RowBox[{"AxesLabel", "->", 
              RowBox[{"{", 
               RowBox[{
               "\"\<\\!\\(\\*\n\
StyleBox[\\\"X\\\",\\nFontSize->24,\\nFontWeight->\\\"Bold\\\"]\\)\>\"", ",", 
                "\"\<\\!\\(\\*\n\
StyleBox[\\\"Y\\\",\\nFontSize->24,\\nFontWeight->\\\"Bold\\\"]\\)\>\"", ",", 
                "\"\<\\!\\(\\*\n\
StyleBox[\\\"Z\\\",\\nFontSize->24,\\nFontWeight->\\\"Bold\\\"]\\)\>\""}], 
               "}"}]}], ",", 
             RowBox[{"AxesEdge", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
             RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
           RowBox[{"ImageResolution", "->", "150"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NotebookEvaluate", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], ",", 
            "\"\<MeshPrepare_v1.1.nb\>\""}], "}"}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
