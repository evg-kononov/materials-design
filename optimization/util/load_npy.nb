Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"inclusionsmesh", "=", 
     RowBox[{"ToElementMesh", "[", "rrnm", "]"}]}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"matrixmesh", "=", 
    RowBox[{"ToElementMesh", "[", 
     RowBox[{"rrbm", ",", 
