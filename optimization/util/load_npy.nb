Cell[CellGroupData[{

Cell["Convert to FEM", "Section",
 CellChangeTimes->{{3.8753338293342304`*^9, 
  3.875333880293784*^9}},ExpressionUUID->"acebcd41-fb00-4c62-bec1-\
6241acd4f083"],

Cell[CellGroupData[{

Cell["Single structure", "Subsubsection",
 CellChangeTimes->{{3.8753339849006233`*^9, 3.875333988445698*^9}, {
  3.8753341916458116`*^9, 
  3.8753342135406637`*^9}},ExpressionUUID->"ea8b6321-7e4c-4433-a561-\
f59ffb8a9643"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"workdir", "=", 
   RowBox[{"SystemDialogInput", "[", 
    RowBox[{"\"\<Directory\>\"", ",", 
     RowBox[{"Directory", "[", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mgen", "=", "1"}], ",", 
      RowBox[{"m", "=", "1"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"rrb", "=", 
      RowBox[{"Image3D", "[", 
       RowBox[{"valCuboids", "[", 
        RowBox[{"[", "mgen", "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"uniquenumber", "=", 
      RowBox[{"\"\<mgen_\>\"", "<>", 
       RowBox[{"ToString", "[", "mgen", "]"}], "<>", "\"\<_m_\>\"", "<>", 
       RowBox[{"ToString", "[", "m", "]"}]}]}], ";", 
     RowBox[{"directoryname", "=", 
      RowBox[{"workdir", "<>", "\"\<mgen_\>\"", "<>", 
       RowBox[{"ToString", "[", "mgen", "]"}], "<>", "\"\<_m_\>\"", "<>", 
       RowBox[{"ToString", "[", "m", "]"}]}]}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"y0", "=", 
    RowBox[{"z0", "=", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xA", "=", 
   RowBox[{"yA", "=", 
    RowBox[{"zA", "=", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rrbm", "=", 
    RowBox[{"RegionResize", "[", 
     RowBox[{
      RowBox[{"ImageMesh", "[", 
       RowBox[{"rrb", ",", 
        RowBox[{"Method", "->", "\"\<DualMarchingCubes\>\""}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x0", ",", "xA"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y0", ",", "yA"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"z0", ",", "zA"}], "}"}]}], "}"}]}], "]"}]}], ";"}], " ", "//",
   "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"Volume", "[", "rrbm", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"xA", "-", "x0"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"yA", "-", "y0"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"zA", "-", "z0"}], ")"}]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.875333963733974*^9, 3.8753340231180673`*^9}, {
  3.8753341139530334`*^9, 3.875334114605582*^9}, {3.87533449379943*^9, 
  3.8753345033722916`*^9}, {3.8753351964874744`*^9, 3.8753352455573845`*^9}, {
  3.87533539726199*^9, 3.875335414991218*^9}, {3.8753355618089743`*^9, 
